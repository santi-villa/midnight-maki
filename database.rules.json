{
  "rules": {
    "coop": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || now - data.child('createdAt').val() > 21600000)",
          "hostUid": {
            ".validate": "newData.val() === auth.uid && $code === auth.uid"
          },
          "guestUid": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid || root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid)"
          },
          ".validate": "newData.hasChildren(['hostUid', 'createdAt'])"
        },
        "toGuest": {
          ".read": "auth != null && root.child('coop').child($code).child('meta').child('guestUid').val() === auth.uid",
          ".write": "auth != null && (root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid || (root.child('coop').child($code).child('meta').child('guestUid').val() === auth.uid && !newData.exists()))"
        },
        "toHost": {
          ".read": "auth != null && root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid",
          ".write": "auth != null && (root.child('coop').child($code).child('meta').child('guestUid').val() === auth.uid || (root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid && !newData.exists()))"
        },
        "presence": {
          ".read": "auth != null && (root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid || root.child('coop').child($code).child('meta').child('guestUid').val() === auth.uid)",
          "host": {
            ".write": "auth != null && root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid",
            ".read": "auth != null"
          },
          "guest": {
            ".write": "auth != null && root.child('coop').child($code).child('meta').child('guestUid').val() === auth.uid",
            ".read": "auth != null"
          }
        },
        ".write": "auth != null && root.child('coop').child($code).child('meta').child('hostUid').val() === auth.uid && !newData.exists()"
      }
    }
  }
}
