{
  "rules": {
    "coop": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          "hostUid": { ".write": "auth != null && (!data.exists() || data.val() === auth.uid || now - root.child('coop/' + $code + '/meta/createdAt').val() > 21600000)", ".validate": "newData.val() === auth.uid" },
          "createdAt": { ".write": "auth != null && (!data.exists() || root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid)" },
          "guestUid": { ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid || root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid)" }
        },
        "toGuest": {
          ".read": "auth != null && root.child('coop/' + $code + '/meta/guestUid').val() === auth.uid",
          ".write": "auth != null && root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "toHost": {
          ".read": "auth != null && root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('coop/' + $code + '/meta/guestUid').val() === auth.uid"
        },
        "presence": {
          ".read": "auth != null && (root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid || root.child('coop/' + $code + '/meta/guestUid').val() === auth.uid)",
          "host": { ".write": "auth != null && root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid" },
          "guest": { ".write": "auth != null && root.child('coop/' + $code + '/meta/guestUid').val() === auth.uid" }
        },
        ".write": "auth != null && root.child('coop/' + $code + '/meta/hostUid').val() === auth.uid && !newData.exists()"
      }
    }
  }
}
