# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# These values are public (they ship inside the app); the security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Playing together (coop): Firebase console > Build > Realtime Database > Create database, then copy its URL, e.g.
# https://mapaches-y-sushi-default-rtdb.firebaseio.com  (or the one for the region you chose)
VITE_FIREBASE_DATABASE_URL=
