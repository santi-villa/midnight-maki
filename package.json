{
  "name": "midnight-maki",
  "version": "0.1.0",
  "private": true,
  "description": "Midnight Maki: Los secretos de Villa Nori — juego cozy pixel art para navegador",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "android": "npm run build && npx cap sync android",
    "apk": "npm run android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/status-bar": "^6.0.2",
    "@fontsource/pixelify-sans": "^5.1.0",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
